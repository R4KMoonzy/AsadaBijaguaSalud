rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el Sistema de Salud Ocupacional — ASADA Bijagua de Upala
    // Permite lectura y escritura desde la aplicación web para la colección de trabajadores y bitácora
    match /trabajadores/{cedula} {
      allow read, write: if true;
    }
    
    match /bitacora/{logId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
